pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            defaultContainer 'maven'
            // -----------------------------------------------------------------------------
            // Pod 定义说明：两个业务容器（maven + docker），jnlp 的默认镜像和连接参数由插件补齐。
            //
            // maven 容器：编译、单元测试、集成测试、打包（内含 JDK 21 + Maven）。
            //   - 挂载 Docker socket：集成测试阶段 Testcontainers 通过它创建 PostgreSQL 容器。
            //   - TESTCONTAINERS_HOST_OVERRIDE：告诉 Testcontainers 用宿主节点 IP 回连它起的容器
            //     （而非 localhost），因为 Pod 有独立网络命名空间。
            //   - TESTCONTAINERS_RYUK_DISABLED：关闭 Ryuk 看门狗容器（受限集群拉不起 privileged），
            //     改由 JVM shutdown hook 清理；被强杀时容器残留由 post { always } 兜底删除。
            //
            // docker 容器：构建并推送镜像（内含 docker CLI，通过 socket 指挥宿主节点守护进程）。
            // -----------------------------------------------------------------------------
            yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: dublin-bikes-backend-build
    ci.kaiwen.dev/workload: maven-build
spec:
  # 三个 Java 项目及其分支共用标签：同一节点最多一个 Maven 构建 Pod。
  # 节点忙时排队，不将构建挤到同一台机器；无需硬编码节点名。
  affinity:
    podAntiAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        - labelSelector:
            matchLabels:
              ci.kaiwen.dev/workload: maven-build
          topologyKey: kubernetes.io/hostname
  containers:
    - name: maven
      image: maven:3.9-eclipse-temurin-21
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      # 与 eventpulse-backend 的已用预算一致；限制覆盖 Maven 及其测试 JVM。
      resources:
        requests:
          cpu: "500m"
          memory: 2Gi
        limits:
          cpu: "2000m"
          memory: 4Gi
      env:
        # 【调整一】告诉 Testcontainers 该用哪个地址连它起的容器。
        # Testcontainers 默认假定容器映射到 localhost，但守护进程在宿主节点上，
        # Pod 有独立的网络命名空间，localhost 是 Pod 自己而非节点。
        # 用 Downward API 取所在节点的 IP，让 Testcontainers 改用该 IP 回连。
        - name: TESTCONTAINERS_HOST_OVERRIDE
          valueFrom:
            fieldRef:
              fieldPath: status.hostIP
        # 【调整二】关闭 Ryuk。Ryuk 需要 --privileged，受限集群通常拉不起来。
        # 关掉后回退到 JVM shutdown hook 清理；被强杀时由 post { always } 兜底。
        - name: TESTCONTAINERS_RYUK_DISABLED
          value: "true"
      volumeMounts:
        # Maven 本地仓库（依赖缓存），挂节点本地 hostPath：缓存随节点持久化，
        # Pod 销毁不丢；与 eventpulse-backend 共用同一份，详见下方 volumes。
        # 挂 /var/cache/maven/repository 而非镜像默认的 /root/.m2/repository：
        # 每个 mvn 显式传 -Dmaven.repo.local 指向这里，不依赖镜像的默认用户/
        # 家目录，将来换镜像（如非 root 变体）也不会悄悄和缓存失联。
        - mountPath: /var/cache/maven/repository
          name: maven-repo
        # 宿主节点的 Docker socket：集成测试阶段 Testcontainers 需要它创建 PostgreSQL 容器。
        - mountPath: /var/run/docker.sock
          name: docker-sock
    - name: docker
      image: docker:27-cli
      command:
        - sleep
      args:
        - "9999999"
      tty: true
      workingDir: /home/jenkins/agent
      # 只限制 CLI；经宿主 socket 创建的容器/镜像构建不受此上限约束。
      resources:
        requests:
          cpu: "100m"
          memory: 128Mi
        limits:
          cpu: "500m"
          memory: 256Mi
      volumeMounts:
        - mountPath: /var/run/docker.sock
          name: docker-sock
    # 保留插件默认镜像和连接参数，仅补充 Agent 的 request / limit。
    - name: jnlp
      resources:
        requests:
          cpu: "100m"
          memory: 256Mi
        limits:
          cpu: "500m"
          memory: 512Mi
  volumes:
    # Maven 本地仓库：节点本地 hostPath，与 eventpulse-backend 等所有 Java 流水线
    # 共用同一路径。相比原先的 NFS PVC（jenkins-maven-cache）：依赖解析和 JAR
    # 读取不再走 NFS，构建更快；代价是缓存按节点各存一份，新节点首次构建要
    # 全量下载一次（DirectoryOrCreate 自动建目录）。
    # 同一节点上并发构建共享此仓库且会并发写，所以每个 mvn 必须带
    # file-lock + file-gav 跨进程锁参数——与 eventpulse 的约定一致，缺了就可能
    # 互相踩坏元数据。
    - name: maven-repo
      hostPath:
        path: /var/cache/jenkins/maven/repository
        type: DirectoryOrCreate
    - name: docker-sock
      hostPath:
        path: /var/run/docker.sock
'''
        }
    }

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'kaiwenyao/dublin-bikes-backend', description: 'Docker image name')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'Image tag override (empty means branch-gitHash-jBUILD_NUMBER, e.g. main-abc1234-j88)')
        booleanParam(name: 'PUSH_IMAGE', defaultValue: true, description: 'Push image to registry')
        booleanParam(name: 'DEPLOY_TO_SERVER', defaultValue: true, description: 'Deploy container to remote server')
        string(name: 'CONTAINER_NAME', defaultValue: 'dublin-bikes-backend', description: 'Container name on remote server')
        string(name: 'CONTAINER_CONFIG_FILE', defaultValue: '/opt/dublin-bikes-backend/application-prod.yaml', description: 'Spring application-prod.yaml path on remote server')
        string(name: 'DOCKER_NETWORK', defaultValue: 'dublin-bikes-network', description: 'Docker network for deployment')
        string(name: 'SSH_KEY_CREDENTIALS_ID', defaultValue: 'server-ssh-key', description: 'Jenkins SSH key credential ID')
    }

    environment {
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        SERVER_HOST_CREDENTIALS_ID = 'hel-host'
        CONFIG_FILE_CREDENTIALS_ID = 'dublin-bikes-backend-prod-yaml'
        // 本次构建的唯一标识，用作 Testcontainers 容器的 Docker 标签。
        // 集成测试给它起的每个容器都打上这个标签，post { always } 据此精确清理，
        // 不会误伤同一节点上并发构建正在使用的容器。
        // BUILD_TAG 形如 jenkins-<任务名>-<构建号>，替换非法字符以匹配标签格式。
        IT_BUILD_TAG = "${env.BUILD_TAG}".replaceAll('[^A-Za-z0-9_.-]', '-')
    }

    stages {
        stage('1. Pull Code') {
            steps {
                checkout scm
            }
        }

        stage('Backend CI') {
            when {
                anyOf {
                    changeset pattern: 'backend/**'
                    triggeredBy 'UserIdCause'
                }
            }
            stages {
                stage('2. Maven Compile') {
                    steps {
                        container('maven') {
                            dir('backend') {
                                sh '''
                                java -version
                                mvn -version
                                mvn -B -ntp -DskipTests compile \
                                    -Dmaven.repo.local=/var/cache/maven/repository \
                                    -Daether.syncContext.named.factory=file-lock \
                                    -Daether.syncContext.named.nameMapper=file-gav
                                '''
                            }
                        }
                    }
                }

                stage('3. Unit Tests') {
                    steps {
                        container('maven') {
                            dir('backend') {
                                sh '''
                                echo "Running unit tests (slice tests, no external services)"
                                mvn -B -ntp test \
                                    -Dtest='!dev.kaiwen.bikes.it.**' \
                                    -Dsurefire.failIfNoSpecifiedTests=false \
                                    -Dmaven.repo.local=/var/cache/maven/repository \
                                    -Daether.syncContext.named.factory=file-lock \
                                    -Daether.syncContext.named.nameMapper=file-gav
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: 'backend/target/surefire-reports/*.xml', allowEmptyResults: false
                        }
                    }
                }

                stage('4. Integration Tests') {
                    steps {
                        container('maven') {
                            dir('backend') {
                                sh '''
                                echo "Running REST API integration tests (Testcontainers: PostgreSQL)"
                                # IntegrationTestBase 读取该变量，给它创建的容器打上本次构建的标签，
                                # 供 post 阶段做兜底清理。
                                export DUBLIN_BIKES_IT_BUILD_TAG="$IT_BUILD_TAG"
                                mvn -B -ntp test \
                                    -Dspring.profiles.active=it \
                                    -Dtest='dev.kaiwen.bikes.it.**' \
                                    -Dsurefire.failIfNoSpecifiedTests=false \
                                    -Dmaven.repo.local=/var/cache/maven/repository \
                                    -Daether.syncContext.named.factory=file-lock \
                                    -Daether.syncContext.named.nameMapper=file-gav
                                '''
                            }
                        }
                    }
                    post {
                        always {
                            junit testResults: 'backend/target/surefire-reports/*.xml', allowEmptyResults: false
                        }
                    }
                }

                stage('5. Code Coverage') {
                    steps {
                        container('maven') {
                            dir('backend') {
                                sh '''
                                echo "Generating merged JaCoCo report (unit + integration tests)"
                                # 单元测试和集成测试阶段的 agent 先后写入同一个 target/jacoco.exec（追加模式），
                                # 这里基于累计数据重新生成一份包含两类测试的完整覆盖率报告。
                                mvn -B -ntp jacoco:report \
                                    -Dmaven.repo.local=/var/cache/maven/repository \
                                    -Daether.syncContext.named.factory=file-lock \
                                    -Daether.syncContext.named.nameMapper=file-gav
                                '''
                            }
                        }
                        // 归档 HTML 报告到构建产物（任何 Jenkins 都可用）。
                        // 若装了 HTML Publisher 插件，还会在构建页面生成 "JaCoCo Coverage" 标签页直接在线看；
                        // 没装也不影响构建，仅回退到下载产物查看。
                        archiveArtifacts artifacts: 'backend/target/site/jacoco/**', allowEmptyArchive: false
                        script {
                            try {
                                publishHTML(target: [
                                    reportName: 'JaCoCo Coverage',
                                    reportDir: 'backend/target/site/jacoco',
                                    reportFiles: 'index.html',
                                    keepAll: true,
                                    alwaysLinkToLastBuild: true,
                                    allowMissing: false
                                ])
                            } catch (Throwable err) {
                                echo "publishHTML skipped (HTML Publisher plugin not installed?): ${err}"
                            }
                        }
                    }
                }

                stage('6. Build & Push Docker Image') {
                    when {
                        not { changeRequest() }
                    }
                    steps {
                        container('docker') {
                            script {
                                def branch = (env.BRANCH_NAME ?: env.GIT_BRANCH ?: 'unknown')
                                    .replaceFirst(/^origin\//, '')
                                    .replaceAll('/', '-')
                                def gitHash = (env.GIT_COMMIT ?: '0000000').take(7)
                                def defaultTag = "${branch}-${gitHash}-j${env.BUILD_NUMBER}"
                                def finalTag = params.IMAGE_TAG?.trim() ? params.IMAGE_TAG.trim() : defaultTag
                                env.FULL_IMAGE = "${params.IMAGE_NAME}:${finalTag}"
                            }

                            withCredentials([
                                usernamePassword(
                                    credentialsId: env.DOCKER_CREDENTIALS_ID,
                                    usernameVariable: 'DOCKER_USER',
                                    passwordVariable: 'DOCKER_PASS'
                                )
                            ]) {
                                dir('backend') {
                                    sh '''
                                    echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                                    docker build -t ${FULL_IMAGE} .
                                    if [ "${PUSH_IMAGE}" = "true" ] || [ "${DEPLOY_TO_SERVER}" = "true" ]; then
                                      docker push ${FULL_IMAGE}
                                    fi
                                    docker logout || true
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('7. Deploy to Server') {
                    when {
                        expression {
                            def rawBranch = env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                            def branch = rawBranch.replaceFirst(/^origin\//, '')
                            def isMain = branch == 'main'
                            def isPR = env.CHANGE_ID != null
                            def deployFlag = params.DEPLOY_TO_SERVER
                            echo "Deploy gate: branch='${branch}' (BRANCH_NAME='${env.BRANCH_NAME}', GIT_BRANCH='${env.GIT_BRANCH}'), isMain=${isMain}, isPR=${isPR}, DEPLOY_TO_SERVER=${deployFlag}"
                            return isMain && !isPR && deployFlag
                        }
                    }
                    environment {
                        CONTAINER_CONFIG_FILE = "${params.CONTAINER_CONFIG_FILE}"
                        DOCKER_NETWORK = "${params.DOCKER_NETWORK}"
                    }
                    steps {
                        container('docker') {
                            withCredentials([
                                string(credentialsId: env.SERVER_HOST_CREDENTIALS_ID, variable: 'SERVER_HOST'),
                                sshUserPrivateKey(credentialsId: params.SSH_KEY_CREDENTIALS_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                                usernamePassword(credentialsId: env.DOCKER_CREDENTIALS_ID, usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS'),
                                file(credentialsId: env.CONFIG_FILE_CREDENTIALS_ID, variable: 'CONFIG_FILE')
                            ]) {
                                sh '''
                                if command -v apk >/dev/null 2>&1; then
                                  apk add --no-cache openssh-client bash
                                fi

                                CONFIG_DIR=$(dirname "${CONTAINER_CONFIG_FILE}")
                                ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no "${SSH_USER}@${SERVER_HOST}" "mkdir -p ${CONFIG_DIR}"

                                scp -i "${SSH_KEY}" -o StrictHostKeyChecking=no "${CONFIG_FILE}" "${SSH_USER}@${SERVER_HOST}:${CONTAINER_CONFIG_FILE}"
                                ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no "${SSH_USER}@${SERVER_HOST}" "SUDO=\$(command -v sudo >/dev/null 2>&1 && echo sudo || true); \$SUDO chown 10001:10001 '${CONTAINER_CONFIG_FILE}' 2>/dev/null || true; \$SUDO chmod 0444 '${CONTAINER_CONFIG_FILE}'"

                                PASS_B64=$(printf '%s' "${DOCKER_PASS}" | base64)
                                USER_B64=$(printf '%s' "${DOCKER_USER}" | base64)
                                IMAGE_B64=$(printf '%s' "${FULL_IMAGE}" | base64)
                                NAME_B64=$(printf '%s' "${CONTAINER_NAME}" | base64)
                                CONFIG_FILE_B64=$(printf '%s' "${CONTAINER_CONFIG_FILE}" | base64)
                                NETWORK_B64=$(printf '%s' "${DOCKER_NETWORK}" | base64)

                                ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=no "${SSH_USER}@${SERVER_HOST}" \
                                "PASS_B64='${PASS_B64}' USER_B64='${USER_B64}' IMAGE_B64='${IMAGE_B64}' NAME_B64='${NAME_B64}' CONFIG_FILE_B64='${CONFIG_FILE_B64}' NETWORK_B64='${NETWORK_B64}' bash -s" <<'REMOTE'
set -e
DOCKER_PASS=$(echo "$PASS_B64" | base64 -d)
DOCKER_USER=$(echo "$USER_B64" | base64 -d)
FULL_IMAGE=$(echo "$IMAGE_B64" | base64 -d)
CONTAINER_NAME=$(echo "$NAME_B64" | base64 -d)
CONTAINER_CONFIG_FILE=$(echo "$CONFIG_FILE_B64" | base64 -d)
DOCKER_NETWORK=$(echo "$NETWORK_B64" | base64 -d)

echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
docker pull "$FULL_IMAGE"
docker network inspect "$DOCKER_NETWORK" >/dev/null 2>&1 || docker network create --ipv6 "$DOCKER_NETWORK"
docker rm -f "$CONTAINER_NAME" || true
docker run -d \
  --name "$CONTAINER_NAME" \
  --restart unless-stopped \
  --network "$DOCKER_NETWORK" \
  -e TZ=UTC \
  -e SPRING_PROFILES_ACTIVE=prod \
  -e SPRING_CONFIG_ADDITIONAL_LOCATION=file:/config/ \
  -v "${CONTAINER_CONFIG_FILE}:/config/application-prod.yaml:ro" \
  "$FULL_IMAGE"
REMOTE
                                '''
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            // 兜底删除集成测试残留的 Testcontainers 容器。
            //
            // 正常路径下 Testcontainers 会在测试进程退出时自行清理（Ryuk 已禁用）；
            // 但构建被取消或进程被强杀时来不及清理，容器会滞留在节点上。
            // 按本次构建的专属标签精确删除，不会影响同一节点上其他正在进行的构建。
            script {
                try {
                    container('docker') {
                        sh '''
                            echo "Cleaning up Testcontainers containers for this build (label: $IT_BUILD_TAG)"
                            stray=$(docker ps -aq --filter "label=dev.kaiwen.it.build=$IT_BUILD_TAG" || true)
                            if [ -n "$stray" ]; then
                                docker rm -f $stray || true
                            else
                                echo "No stray containers found"
                            fi
                        '''
                    }
                } catch (err) {
                    echo "Testcontainers cleanup skipped: ${err}"
                }
            }
            cleanWs()
        }
    }
}
